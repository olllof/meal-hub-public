{
  "buildCommand": "npm run build",
  "outputDirectory": "meal-hub-public",
  "env": {
    "NODE_ENV": "production"
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js",
      "methods": ["GET", "POST", "PUT", "DELETE", "PATCH"]
    },
    {
      "src": "^/(?!api/)",
      "dest": "/index.html"
    }
  ]
}
